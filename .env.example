# Copy to .env.local and fill in from the Supabase dashboard.
# .env.local is gitignored. Never commit real values.

# --- Database -------------------------------------------------------------
# Project Settings → Database → Connection string. Needs the DATABASE PASSWORD,
# which is not one of the API keys below.
#
# Both go through the pooler; the port selects the mode.
#   DATABASE_URL — session pooler (5432). Runtime.
#   DIRECT_URL   — session pooler (5432). Drizzle migrations.
#
# Runtime is NOT on the transaction pooler (6543), which is the usual advice
# for serverless. Measured on this project, postgres.js against transaction
# mode hangs once the query queue deepens — a page issuing eight concurrent
# queries on a small pool never returns, while session mode queued 100 queries
# over 3 connections fine. A hang is worse than an error, so runtime stays on
# session mode. See src/server/db/index.ts for the numbers.

DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"
DIRECT_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# --- API ------------------------------------------------------------------
# Project Settings → API keys.

NEXT_PUBLIC_SUPABASE_URL="https://<project-ref>.supabase.co"

# The address the app is reachable at, e.g. "https://life-os-ans-projects.vercel.app".
# Used for the MCP endpoint shown in Account. Without it, that address falls back
# to the host the request arrived on — which on Vercel is the per-deployment
# hostname (life-os-<hash>-….vercel.app), so the token screen would show an
# address that changes on every deploy.
NEXT_PUBLIC_SITE_URL=""

# Publishable key (sb_publishable_...). Safe in the browser; RLS still applies.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=""

# Secret key (sb_secret_...). Bypasses RLS. Server-side only — never expose to
# the browser, never commit, never log.
SUPABASE_SECRET_KEY=""
